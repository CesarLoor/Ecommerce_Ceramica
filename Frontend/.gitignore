# ============================================================
# .gitignore — Frontend (Vite / React / TypeScript)
# ============================================================

# ── Dependencias ─────────────────────────────────────────────
node_modules/

# ── Build ─────────────────────────────────────────────────────
dist/
dist-ssr/
*.tsbuildinfo

# ── Variables de entorno ──────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Cobertura de pruebas ──────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Reportes generados ────────────────────────────────────────
eslint-report.json

# ── Caché ─────────────────────────────────────────────────────
.vite/
.cache/
.eslintcache

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── IDEs y editores ───────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
.DS_Store

# ── Sistema operativo ─────────────────────────────────────────
Thumbs.db
Desktop.ini