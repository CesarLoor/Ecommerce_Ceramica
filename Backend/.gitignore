# ============================================================
# .gitignore — Backend (Node.js / Express / Mongoose)
# ============================================================

# ── Dependencias ─────────────────────────────────────────────
node_modules/

# ── Variables de entorno ──────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Cobertura de pruebas ──────────────────────────────────────
coverage/
.coverage/
*.lcov
.nyc_output/

# ── Resultados de pruebas de carga k6 ────────────────────────
k6/results/

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ── Build ─────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Caché ─────────────────────────────────────────────────────
.cache/
.eslintcache

# ── IDEs y editores ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.vscode-test/

# ── Sistema operativo ─────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Temporales ────────────────────────────────────────────────
*.tmp
*.temp