# ============================================================
# .gitignore — Raíz del proyecto Ecommerce Ceramica (Barroco)
# ============================================================

# ── Dependencias ─────────────────────────────────────────────
node_modules/

# ── Variables de entorno ──────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Build / Dist ──────────────────────────────────────────────
dist/
dist-ssr/
build/
*.tsbuildinfo

# ── Cobertura de pruebas ──────────────────────────────────────
coverage/
.coverage/
*.lcov
.nyc_output/

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Reportes generados ────────────────────────────────────────
eslint-report.json
k6/results/

# ── Caché ─────────────────────────────────────────────────────
.cache/
.vite/
.eslintcache

# ── IDEs y editores ───────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ── Sistema operativo ─────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Temporales ────────────────────────────────────────────────
*.tmp
*.temp

# ── Firebase (eliminado del proyecto) ─────────────────────────
.firebase/
firebase-debug.log
.firebaserc
firebase.json
